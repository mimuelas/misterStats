    {% if user.loans %}
      <button class="btn tab btn-popup"
        data-popup="loan-request"
        data-preload="player-community-info"
        data-id_player="{{ id_player }}"
      >{{ trans('Cesión') }}</button>
    {% endif %}
  </div>
{% endif %}
<div class="content">
  <form id="form-bid">
    <input type="hidden" name="offeree_id" value="{{ pre.owner.id }}" />
    <input type="hidden" name="id_market" value="{{ pre.market.id|default(0) }}">
    <input type="hidden" name="id_player" value="{{ id_player }}">
    <input type="hidden" name="action" id="action" value="{{ (pre.bid.type == 'normal' and pre.bid.isActive == 1) ? 'remove' : (pre.bid.isActive == 1 ? 'update' : 'bid') }}">
    {% if pre.bid.barter|length > 0 %}
      <input type="hidden" name="barter" value="{{ pre.bid.barter|keys }}">
    {% endif %}
    <div class="input-sub-add" data-step="10" data-increment="10">
      <button type="button" class="btn num-sub btn--secondary btn--lg">
        {{ svg('remove') }}
      </button>
      <div class="input">
        <input type="tel"
          id="input-tel"
          class="input-amount"
          name="bid"
          value="{{ pre.bid.type == 'normal' ? pre.bid.input|number_format : pre.market.price|number_format }}"
          autocomplete="off"
          oninput="check_bid(this)"
          data-update="#input-range"
        >
      </div>
      <button type="button" class="btn num-add btn--secondary btn--lg">
        {{ svg('add') }}
      </button>
    </div>
    <div class="range">
      <input type="range"
        id="input-range"
        name="bid_range"
        min="{{ pre.market.price }}"
        value="{{ pre.bid.type == 'normal' ? pre.bid.input : pre.market.price }}"
        step="1"
        data-update="#input-tel"
      >
      <div class="steps">
        <div class="step">{{ trans('Mín.') }}</div>
        <div class="step">{{ trans('Máx.') }}</div>
      </div>
    </div>
    <div class="barter-players">
      {% for i in pre.bid.barter %}
        <button type="button" class="btn btn--wide btn-barter-player" data-id_player="{{ i.id_player }}">
          <div class="player-avatar player-avatar--xs">
            <img src="{{ i.photoUrl }}" loading="lazy">
          </div>
          <div class="name">{{ i.name }}</div>
          <div class="value">· € {{ i.value|number_format }}</div>
          {{ svg('cross-circle') }}
        </button>
      {% endfor %}
    </div>
  </form>
</div>
<div class="footer">
  <div class="buttons">
    {% if pre.owner.id > 0 %}
      <button type="button"
        class="btn btn--secondary btn--lg btn-barter btn-popup popup-navigate"
        data-popup="barter-players"
        data-preload="players"
        data-barter='{{ pre.bid.barter|json_encode }}'
        {% if pre.bid.barter|length > 2 %}disabled{% endif %}
      >
        {{ trans('ADD_BARTER') }}
      </button>
    {% endif %}
    {% if pre.bid.type == 'normal' and pre.bid.isActive == 1 %}
      <button type="button" id="btn-send" class="btn btn--red btn--lg" data-ajax="bid" data-event="place_bid">{{ trans('Retirar') }}</button>
    {% else %}
      {% if pre.bid.isActive == 1 %}
        <button type="button" id="btn-send" class="btn btn--primary btn--lg" data-ajax="bid" data-event="place_bid">{{ trans('Actualizar') }}</button>
      {% else %}
        <button type="button" id="btn-send" class="btn btn--primary btn--lg" data-ajax="bid" data-event="place_bid">{{ pre.owner.id > 0 ? trans('Enviar oferta') : trans('Pujar') }}</button>
      {% endif %}
    {% endif %}
  </div>
</div>

<script>popupData.hasBarter = {{ pre.bid.barter|length > 0 }}</script>

  </script>
      <script type="text/template" id="twig-sale">
      <div class="header">
  <h3>{{ pre.name }}</h3>
</div>
<div class="tabs tabs-wrapper">
  <button class="btn tab active">{{ trans('Vender') }}</button>
  <button class="btn tab btn-popup"
    data-popup="rescind"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Despedir') }}</button>
  <button class="btn tab btn-popup"
    data-popup="loanable"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Ceder') }}</button>
  <button class="btn tab btn-popup"
    data-popup="clause-set"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Cláusula') }}</button>
</div>
<div class="content">
  <form data-step="10" data-increment="10">
    <input type="hidden" name="id_player" value="{{ id_player }}">
    <input type="hidden" name="action" id="action" value="{{ pre.market.id ? 'remove' : 'sale' }}">
    <div class="input-sub-add" data-step="10" data-increment="10">
      <button type="button" class="btn num-sub btn--secondary btn--lg">
        {{ svg('remove') }}
      </button>
      <div class="input">
        <input type="tel"
          id="input-tel"
          name="price"
          value="{{ pre.market.price|number_format }}"
          autocomplete="off"
          oninput="check_sale(this)"
          data-update="#input-range"
        >
      </div>
      <button type="button" class="btn num-add btn--secondary btn--lg">
        {{ svg('add') }}
      </button>
    </div>
    <div class="range">
      <input type="range"
        id="input-range"
        name="price"
        min="{{ pre.value }}"
        max="99999999"
        value="{{ pre.market.price }}"
        step="1"
        data-update="#input-tel"
      >
      <div class="steps">
        <div class="step">{{ trans('Mín.') }}</div>
        <div class="step">{{ trans('Máx.') }}</div>
      </div>
    </div>
  </form>
</div>
<div class="footer">
  <div class="buttons">
    <button type="button" id="btn-send" class="btn btn--lg {{ pre.market.id ? 'btn--red' : 'btn--primary' }}" data-ajax="sale">{{ pre.market.id ? trans('Retirar') : trans('Vender') }}</button>
  </div>
</div>

    </script>
