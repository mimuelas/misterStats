  <script type="text/template" id="twig-formation">
    <div class="header">
  <h3>{{ trans('Formación') }}</h3>
</div>
<div class="content no-padding">
  <div class="formation-grid">
    {% for formation in data.formations %}
      <button
        class="btn btn--xl btn--secondary {% if formation.free %}btn-free{% else %}btn-credits{% endif %} {% if 'pack' in formation.name %}btn-pack{% endif %} {% if formation.name == 'pack_community' %}btn-pack-community{% endif %}"
        {% if 'pack' not in formation.name %}
          data-formation="{{ formation.name }}"
        {% endif %}
        {% if not formation.free %}
          data-sku="{{ formation.sku }}"
        {% endif %}
        data-id="{{ user.id_uc }}"
      >
        {% if 'pack' in formation.name %}
          {{ trans('FORMATION_PACK') }}
          {% if formation.name == "pack_community" %}
            <small>
              {{ trans('FORMATION_PACK_COMMUNITY_HELP_TEXT') }}
            </small>
          {% endif %}
        {% else %}
          {{ formation.name }}
        {% endif %}
        {% if not formation.free %}
          <div class="price">
            {% if cfg.user.uc_created > 1755165600 and cfg.user.mode == 'contest' %}
              {{ trans('CURRENT_SEASON') }}
            {% endif %}
            {{ svg('coin') }} {{ formation.price }}
          </div>
        {% endif %}
      </button>
    {% endfor %}
  </div>
</div>

  </script>
  <script type="text/template" id="twig-sale">
    <div class="header">
  <h3>{{ pre.name }}</h3>
</div>
<div class="tabs tabs-wrapper">
  <button class="btn tab active">{{ trans('Vender') }}</button>
  <button class="btn tab btn-popup"
    data-popup="rescind"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Despedir') }}</button>
  <button class="btn tab btn-popup"
    data-popup="loanable"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Ceder') }}</button>
  <button class="btn tab btn-popup"
    data-popup="clause-set"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Cláusula') }}</button>
</div>
<div class="content">
  <form data-step="10" data-increment="10">
    <input type="hidden" name="id_player" value="{{ id_player }}">
    <input type="hidden" name="action" id="action" value="{{ pre.market.id ? 'remove' : 'sale' }}">
    <div class="input-sub-add" data-step="10" data-increment="10">
      <button type="button" class="btn num-sub btn--secondary btn--lg">
        {{ svg('remove') }}
      </button>
      <div class="input">
        <input type="tel"
          id="input-tel"
          name="price"
          value="{{ pre.market.price|number_format }}"
          autocomplete="off"
          oninput="check_sale(this)"
          data-update="#input-range"
        >
      </div>
      <button type="button" class="btn num-add btn--secondary btn--lg">
        {{ svg('add') }}
      </button>
    </div>
    <div class="range">
      <input type="range"
        id="input-range"
        name="price"
        min="{{ pre.value }}"
        max="99999999"
        value="{{ pre.market.price }}"
        step="1"
        data-update="#input-tel"
      >
      <div class="steps">
        <div class="step">{{ trans('Mín.') }}</div>
        <div class="step">{{ trans('Máx.') }}</div>
      </div>
    </div>
  </form>
</div>
<div class="footer">
  <div class="buttons">
    <button type="button" id="btn-send" class="btn btn--lg {{ pre.market.id ? 'btn--red' : 'btn--primary' }}" data-ajax="sale">{{ pre.market.id ? trans('Retirar') : trans('Vender') }}</button>
  </div>
</div>

  </script>
      <script type="text/template" id="twig-rescind">
      <div class="header">
  <h3>{{ pre.name }}</h3>
</div>
<div class="tabs tabs-wrapper">
  <button class="btn tab btn-popup"
    data-popup="sale"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Vender') }}</button>
  <button class="btn tab active">{{ trans('Despedir') }}</button>
  <button class="btn tab btn-popup"
    data-popup="loanable"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Ceder') }}</button>
  <button class="btn tab btn-popup"
    data-popup="clause-set"
    data-id_player="{{ id_player }}"
    data-preload="player-community-info"
  >{{ trans('Cláusula') }}</button>
</div>
<div class="content">
  <form>
    <input type="hidden" name="id_player" value="{{ id_player }}">
    <input type="text" readonly value="{{ (pre.value * 0.8)|number_format }}">
    <p>{{ trans('El jugador quedará libre de forma inmediata por el 80% de su valor') }}</p>
  </form>
</div>
<div class="footer">
  <div class="buttons">
    <button type="button" class="btn btn--primary btn--lg btn-credits" data-sku="rescind" data-id_player="{{ id_player }}">
      {{ trans('Despedir') }} {{ svg('coin') }} {{ cfg.sku_prices.rescind }}
    </button>
  </div>
</div>

